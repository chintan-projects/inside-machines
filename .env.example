# Server-only settings. Copy to .env.local; never put these in VITE_ variables.
# Owner generation stays off until every routed credential and budget are set.
OPENAI_API_KEY=
INSIDE_BUDGET_USD=0

# Opt in only after the same lesson evaluations pass for Claude authoring.
# Research, review, chat and speech keep their explicit OpenAI routes.
# Never place either credential in a browser / VITE_ environment variable.
INSIDE_AUTHORING_PROVIDER=openai
ANTHROPIC_API_KEY=

# Use three different random values; keep the owner code private.
INSIDE_INVITE_CODE=
INSIDE_OWNER_CODE=
INSIDE_SESSION_SECRET=

# Required for production. Local development uses .data/inside.sqlite3.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Required at Vercel build time so the versioned dist/ shell reaches the CDN.
VERCEL_FASTAPI_STATIC_CDN=1
