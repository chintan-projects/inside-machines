{
  "name": "inside-machines-local-lab",
  "private": true,
  "type": "module",
  "imports": {
    "#anatomy-tube": {
      "types": "./native/anatomy-tube.d.mts",
      "default": "./vendor/anatomy/kit/tube.mjs"
    }
  },
  "scripts": {
    "build": "node scripts/check-deployment-sources.mjs && tsc --noEmit && node native/verify.mjs && vite build && node scripts/pwa-build.mjs",
    "start": ".venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000",
    "test": "node --test tests/*.test.mjs",
    "build:lab": "node scripts/build.mjs",
    "start:lab": "node scripts/serve.mjs",
    "dev": "vite",
    "lint": "eslint web vite.config.ts eslint.config.js",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.27.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "ignore": "5.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  }
}
