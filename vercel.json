{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "node scripts/vercel-build.mjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "includeFiles": "{config/**,vendor/workspace_shared/**,public/fonts/**,public/figures/**}",
      "excludeFiles": "{.env*,.data/**,shots/**,tests/**,research/**,vendor/anatomy/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
