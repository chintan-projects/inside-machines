# Build-only Linux environment. No account credentials or user data enter this image.
FROM ghcr.io/astral-sh/uv:0.10.0 AS uv
FROM node:24-bookworm-slim
COPY --from=uv /uv /uvx /usr/local/bin/
RUN uv python install 3.13
WORKDIR /app
ENV VERCEL_FASTAPI_STATIC_CDN=1
CMD ["npx", "--yes", "vercel@64.5.0", "build", "--no-color"]
